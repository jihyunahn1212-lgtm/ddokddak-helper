# ============================================================
# 똑딱 정리 도우미 .gitignore
# 원칙: 실제 업무 데이터(재무·개인정보)는 절대 올리지 않는다.
#       가상 샘플과 코드·문서만 올린다.
# ============================================================

# ---------- 1) 실제 업무 데이터 (가장 중요) ----------
# 엑셀·CSV·한글 문서는 전부 제외. 시스템에서 내려받은 원본이나
# 웹앱에서 내려받은 결과(정리결과_날짜.xlsx)가 실수로 올라가는 것을 막는다.
*.xlsx
*.xls
*.xlsm
*.xlsb
*.csv
*.tsv
*.hwp
*.hwpx
*.pdf

# 예외: 이름에 '가상'이 들어간 파일만 올린다 (전부 가짜 데이터).
#   예) 샘플_입력/가상_원본.xlsx, 샘플_입력/가상_주자금_원본.xlsx,
#       정리_템플릿_가상샘플.xlsx, 정리결과_가상샘플.xlsx
# 실제 파일 이름에는 '가상'을 넣지 마세요.
!*가상*.xlsx

# 웹앱의 💾 저장이 만드는 작업 파일 (금액·전일잔액 등이 들어 있음)
작업저장_*.json
작업저장*.json

# 엑셀이 파일을 열어 둘 때 생기는 임시 파일 (실제 파일 이름이 노출됨)
~$*
.~lock.*

# 테스트·임시 출력물
test_출력*.xlsx
*.tmp
*.temp
*.bak
*.log
*.tmp.js

# ---------- 2) 비밀 정보 ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.*
credentials.*

# ---------- 3) 내 컴퓨터에서만 쓰는 도구 설정 ----------
# Claude Code 설정·미리보기 설정 (개인 PC 경로가 들어갈 수 있음)
.claude/
.vscode/
.idea/
*.code-workspace

# ---------- 4) 자동 생성·설치되는 것 ----------
# Node
node_modules/
npm-debug.log*
yarn-error.log*

# Python (샘플 생성 스크립트 실행 시 생김)
__pycache__/
*.py[cod]
.venv/
venv/

# ---------- 5) 운영체제 찌꺼기 ----------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
